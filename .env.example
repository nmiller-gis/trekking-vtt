# Copy to .env and fill in values before running docker compose

# Required — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production

# Port exposed on the host (container always listens on 3001)
PORT=3001

# Set to your public URL if the client is served from a different origin than the server.
# Leave empty when the server serves the client (the default Docker setup).
# CLIENT_ORIGIN=https://your-domain.com
